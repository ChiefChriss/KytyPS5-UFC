#include "cmake_config.h"

#define KYTY_GIT_VERSION "@KYTY_GIT_VERSION@"
// Short, human-facing commit name used in build labels.
#define KYTY_GIT_HASH "@KYTY_GIT_HASH@"
// Full commit identity used for compatibility checks.
#define KYTY_GIT_REVISION "@KYTY_GIT_REVISION@"

// Local build iteration ("UFC Dev NNN | "), empty when build-iteration.txt is absent.
#define KYTY_BUILD_ITERATION_LABEL "@KYTY_BUILD_ITERATION_LABEL@"

/* Build provenance, shown in the window title and in crash reports. */
#if defined(KYTY_OFFICIAL_BUILD)
#define KYTY_BUILD_LABEL KYTY_BUILD_ITERATION_LABEL "Official build " KYTY_RELEASE_TAG
#elif defined(KYTY_FORK_BUILD)
#define KYTY_BUILD_LABEL                                                                           \
	KYTY_BUILD_ITERATION_LABEL "Fork build " KYTY_BUILD_REPOSITORY " " KYTY_GIT_HASH
#else
#define KYTY_BUILD_LABEL KYTY_BUILD_ITERATION_LABEL "Source build " KYTY_GIT_HASH
#endif
