# Recomputed at build time: dirty working-tree edits invalidate translated IR safely.
file(GLOB_RECURSE inputs
    "${SOURCE_ROOT}/graphics/shader/*.cpp" "${SOURCE_ROOT}/graphics/shader/*.h"
    "${SOURCE_ROOT}/graphics/guest_gpu/gpu_format.*" "${SOURCE_ROOT}/*.h")
list(APPEND inputs "${SOURCE_ROOT}/graphics/host_gpu/renderer/pipeline/shaderDiskCache.cpp"
    "${SOURCE_ROOT}/graphics/host_gpu/renderer/pipeline/shaderDiskCache.h"
    "${SOURCE_ROOT}/shader_cache_version.cmake")
list(REMOVE_DUPLICATES inputs)
list(SORT inputs)
set(identity "UFC-Senaxx-cache-v1;${COMPILER_ID};${BUILD_TYPE}")
set(switches "")
foreach(input IN LISTS inputs)
    file(SHA256 "${input}" digest)
    file(RELATIVE_PATH relative "${SOURCE_ROOT}" "${input}")
    string(APPEND identity "\n${relative}:${digest}")
    file(READ "${input}" contents)
    string(REGEX MATCHALL "KYTY_[A-Z][A-Z0-9_]+" names "${contents}")
    list(APPEND switches ${names})
endforeach()
list(REMOVE_DUPLICATES switches)
list(SORT switches)
string(SHA256 fingerprint "${identity}")
list(LENGTH switches count)
set(output "#pragma once\n#include <array>\n#include <string_view>\nnamespace ShaderCacheVersion {\ninline constexpr std::string_view Fingerprint = \"${fingerprint}\";\ninline constexpr std::array<std::string_view, ${count}> Switches = {\n")
foreach(name IN LISTS switches)
    string(APPEND output "\"${name}\",\n")
endforeach()
string(APPEND output "};\n}\n")
if(EXISTS "${OUTPUT_FILE}")
    file(READ "${OUTPUT_FILE}" previous)
else()
    set(previous "")
endif()
if(NOT previous STREQUAL output)
    file(WRITE "${OUTPUT_FILE}" "${output}")
endif()
